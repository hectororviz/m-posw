<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <SearchView
            android:id="@+id/svAcreedores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:queryHint="Buscar acreedor"
            android:iconifiedByDefault="false" />

        <TextView android:id="@+id/tvAcreedoresInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Entradas.Support" />

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nombre"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textAppearance="@style/TextAppearance.Entradas.Support" />

            <TextView
                android:layout_width="@dimen/acreedor_estado_w"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="Estado"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textAppearance="@style/TextAppearance.Entradas.Support" />

            <TextView
                android:layout_width="@dimen/acreedor_monto_w"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:text="Deuda"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textAppearance="@style/TextAppearance.Entradas.Support" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="?attr/colorOutline" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvConfigAcreedores"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />

        <TextView android:id="@+id/tvAcreedoresError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAcreedorAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Agregar acreedor"
        app:srcCompat="@android:drawable/ic_input_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>

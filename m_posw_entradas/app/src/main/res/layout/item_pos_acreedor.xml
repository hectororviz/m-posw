<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView android:id="@+id/tvAcreedorName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textStyle="bold"
        android:textSize="16sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView android:id="@+id/tvAcreedorEstado"
        android:layout_width="@dimen/acreedor_estado_w"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:textStyle="bold"
        android:textSize="11sp"
        android:singleLine="true" />

    <TextView android:id="@+id/tvAcreedorSaldo"
        android:layout_width="@dimen/acreedor_monto_w"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:textSize="15sp"
        android:singleLine="true" />
</LinearLayout>

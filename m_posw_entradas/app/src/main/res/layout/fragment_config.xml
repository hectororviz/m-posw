<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarConfig"
            style="@style/Widget.Entradas.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/config_titulo" />

        <!-- Conexión al servidor -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/seccion_conexion"
            android:textAppearance="@style/TextAppearance.Entradas.SectionTitle" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="URL del servidor">

            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Token de acceso"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanPairing"
                style="@style/Widget.Entradas.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/escanear_qr" />

            <Space android:layout_width="8dp" android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTest"
                style="@style/Widget.Entradas.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/probar_conexion" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.Entradas.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/guardar" />

        <TextView android:id="@+id/tvConfigStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.Entradas.Label" />

        <!-- Impresora -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/seccion_impresora"
            android:textAppearance="@style/TextAppearance.Entradas.SectionTitle" />

        <TextView android:id="@+id/tvPrinterStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Entradas.Label" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrinterChoose"
                style="@style/Widget.Entradas.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/impresora_elegir" />

            <Space android:layout_width="8dp" android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrinterTest"
                style="@style/Widget.Entradas.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/impresora_probar" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrinterForget"
                style="@style/Widget.Entradas.Button.Neutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/impresora_olvidar" />

            <Space android:layout_width="8dp" android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBtSettings"
                style="@style/Widget.Entradas.Button.Neutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/impresora_ajustes_bt" />
        </LinearLayout>

        <!-- Apariencia -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tamaño (POS)"
            android:textAppearance="@style/TextAppearance.Entradas.SectionTitle" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tgTextScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScaleS"
                style="@style/Widget.Entradas.Button.Neutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checkable="true"
                android:text="Chico"
                app:backgroundTint="@color/toggle_sector_fill"
                android:textColor="@color/toggle_sector_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScaleM"
                style="@style/Widget.Entradas.Button.Neutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checkable="true"
                android:text="Medio"
                app:backgroundTint="@color/toggle_sector_fill"
                android:textColor="@color/toggle_sector_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScaleL"
                style="@style/Widget.Entradas.Button.Neutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checkable="true"
                android:text="Grande"
                app:backgroundTint="@color/toggle_sector_fill"
                android:textColor="@color/toggle_sector_text" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/apariencia"
            android:textAppearance="@style/TextAppearance.Entradas.SectionTitle" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tgTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemeSystem"
                style="@style/Widget.Entradas.Button.Neutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checkable="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/tema_sistema"
                app:backgroundTint="@color/toggle_sector_fill"
                android:textColor="@color/toggle_sector_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemeLight"
                style="@style/Widget.Entradas.Button.Neutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checkable="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/tema_claro"
                app:backgroundTint="@color/toggle_sector_fill"
                android:textColor="@color/toggle_sector_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemeDark"
                style="@style/Widget.Entradas.Button.Neutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checkable="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/tema_oscuro"
                app:backgroundTint="@color/toggle_sector_fill"
                android:textColor="@color/toggle_sector_text" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Avanzado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/seccion_avanzado"
            android:textAppearance="@style/TextAppearance.Entradas.SectionTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Modo prueba"
            android:textAppearance="@style/TextAppearance.Entradas.Label" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swModoPrueba"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Simular ventas e impresión (no se registra nada)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Muestra datos ficticios, vende e imprime tickets de prueba con el diseño real. QR y socio quedan deshabilitados."
            android:textAppearance="@style/TextAppearance.Entradas.Support" />

        <TextView android:id="@+id/tvVersions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.Entradas.Support" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tipografía por rol: pesos altos para luz fuerte. Sin res/font se usan
         los pesos del sistema (medium = 500, bold = 700). -->
    <style name="TextAppearance.Entradas.ScreenTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Entradas.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Entradas.ProductName" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Entradas.Price" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Entradas.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Entradas.Support" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Botones: altura 56dp y radio único de 12dp -->
    <style name="Widget.Entradas.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.Entradas.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Tarjeta: superficie + borde 1dp, sin elevation -->
    <style name="Widget.Entradas.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.Entradas.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerTopLeft">12dp</item>
        <item name="boxCornerTopRight">12dp</item>
        <item name="boxCornerBottomLeft">12dp</item>
        <item name="boxCornerBottomRight">12dp</item>
    </style>

    <style name="Shape.Entradas.ImageTop" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.Entradas.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Entradas.SectionTitle</item>
    </style>

    <!-- Diálogos con radio 24dp -->
    <style name="ThemeOverlay.Entradas.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/Shape.Entradas.Dialog</item>
    </style>
    <style name="Shape.Entradas.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- BottomSheet con esquinas superiores de 24dp -->
    <style name="Theme.Entradas.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Entradas.BottomSheet</item>
    </style>
    <style name="Widget.Entradas.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/Shape.Entradas.Sheet</item>
    </style>
    <style name="Shape.Entradas.Sheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>

# --- Docker ---
# Tag de la imagen a usar. Para rollback, cambiar a v1.1.0 (estable).
DOCKER_TAG=latest

# Host público que Caddy expone para esta instancia (API en /api/*).
# El POS externo pega a https://${CADDY_HOST}/api/entradas/...
CADDY_HOST=pos.csdsoler.com.ar

# --- DB ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public

# --- Backend ---
JWT_SECRET=
CORS_ORIGIN=

# Credenciales de administrador inicial
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Front (Vite) ---
# Porque Caddy/Nginx expone la API en /api/*
VITE_API_BASE_URL=/api

# Dejalo vacío si vas a proxyar /uploads con Caddy/Nginx (recomendado)
VITE_UPLOADS_BASE_URL=

# --- MercadoPago ---
# Entorno: test (TEST-) o live (APP_USR-). Si se omite se infiere por prefijo del token.
MP_ENV=live
# Tokens separados para homologación sin tocar producción
MP_TEST_ACCESS_TOKEN=
MP_LIVE_ACCESS_TOKEN=
# Legacy (fallback si no se usan los separados)
MP_ACCESS_TOKEN=
MP_COLLECTOR_ID=
MP_CURRENCY_ID=ARS

# Integrator ID opcional, solo para partners certificados
MP_INTEGRATOR_ID=

# Secreto para validar firma de webhooks (opcional en desarrollo)
MP_WEBHOOK_SECRET=
MP_WEBHOOK_SECRET_LIVE=
MP_WEBHOOK_SECRET_TEST=

# Rechaza webhooks payment/merchant_order sin firma válida (requiere MP_WEBHOOK_SECRET).
# En producción el código fuerza strict=true aunque quede en false. Homologación MP: true.
MP_WEBHOOK_STRICT_PAYMENT=true

# Solo diagnóstico: loguea query+headers+body crudo de cada webhook (apagar en prod tras usar).
DEBUG_MP_WEBHOOK_DUMP=false

# --- MercadoPago OAuth ---
INSTANCE_SUBDOMAIN=soler
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=https://oauth.mposw.com.ar/callback

# --- Notificaciones (WhatsApp Cloud API) ---
# Credenciales de la app de Meta Business para WhatsApp Cloud API.
# Se configuran desde la GUI en /admin/notificaciones.
# WABA_PHONE_NUMBER_ID=
# WABA_ACCESS_TOKEN=
# WABA_BUSINESS_ACCOUNT_ID=
